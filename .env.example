# 候选人/面试官链接与API Base
WEB_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000

# NestJS
PORT=3000

# MySQL（本机 Docker Compose 默认值；容器内 DB_HOST 会被 docker-compose 覆盖为 mysql 服务名）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=prism
DB_PASSWORD=prism_pass
DB_NAME=prism_demo

# TypeORM：PoC 阶段 true（建表自动同步）；上线后建议 false + migration
DB_SYNCHRONIZE=true
DB_LOGGING=false

# MySQL root 密码（仅 docker-compose 启动 mysql 容器用）
MYSQL_ROOT_PASSWORD=root_pass

# JWT
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=12h

# 阿里云百炼（OpenAI 兼容）
DASHSCOPE_API_KEY=replace-with-real-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 管理接口
ADMIN_KEY=replace-with-strong-admin-key

# 运行环境：development | production
NODE_ENV=development

# Web 容器对外端口（docker-compose 中映射到容器 80）
WEB_PORT=8080
